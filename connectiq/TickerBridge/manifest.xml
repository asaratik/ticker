<?xml version="1.0"?>
<!--
  The product list below is a starting point, not a complete one -- there
  are hundreds of Garmin devices and each needs to be listed explicitly.
  Add yours with the Connect IQ VS Code extension ("Monkey C: Edit
  Products"), which knows the exact ids, rather than guessing at the string.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="4a3030f2144c45cfb42bca12106da2cb"
        type="watch-app"
        name="@Strings.AppName"
        entry="TickerBridgeApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.1.0">

        <iq:products>
            <iq:product id="fenix6"/>
            <iq:product id="fenix6pro"/>
            <iq:product id="fenix7"/>
            <iq:product id="fenix7pro"/>
            <iq:product id="fenix8solar47mm"/>
            <iq:product id="fr255"/>
            <iq:product id="fr265"/>
            <iq:product id="fr955"/>
            <iq:product id="fr965"/>
            <iq:product id="venu2"/>
            <iq:product id="venu3"/>
            <iq:product id="epix2"/>
            <iq:product id="vivoactive5"/>
        </iq:products>

        <iq:permissions>
            <!-- makeWebRequest, i.e. everything this app does. -->
            <iq:uses-permission id="Communications"/>
            <!-- Live heart rate from the watch's own optical sensor. -->
            <iq:uses-permission id="Sensor"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
